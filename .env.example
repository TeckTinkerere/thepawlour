# Optional content sources. With none of these set, the site runs from
# content/site.json. See CONTENT_GUIDE.md.

# ID of a Google Sheet published to the web (File > Share > Publish to the web).
# CONTENT_SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Any URL returning JSON in the shape of content/site.json. Takes precedence
# over CONTENT_SHEET_ID when both are set.
# CONTENT_JSON_URL=https://example.com/pawlour-content.json

# How often a live page re-reads the content source, in seconds. Default 300.
# CONTENT_REVALIDATE_SECONDS=300
